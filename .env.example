NODE_ENV=development
APP_MODE=development
PORT=5000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
API_PREFIX=/api

# Rate Limits (Development Mode)
DEV_CLONE_RATE_LIMIT_MAX=100
DEV_CLONE_RATE_LIMIT_WINDOW_MS=900000
DEV_POLL_RATE_LIMIT_MAX=5000
DEV_POLL_RATE_LIMIT_WINDOW_MS=900000
DEV_PREVIEW_RATE_LIMIT_MAX=5000
DEV_PREVIEW_RATE_LIMIT_WINDOW_MS=900000

# Rate Limits (Production Mode)
PROD_CLONE_RATE_LIMIT_MAX=20
PROD_CLONE_RATE_LIMIT_WINDOW_MS=900000
PROD_POLL_RATE_LIMIT_MAX=600
PROD_POLL_RATE_LIMIT_WINDOW_MS=900000
PROD_PREVIEW_RATE_LIMIT_MAX=1000
PROD_PREVIEW_RATE_LIMIT_WINDOW_MS=900000

# Future Production Token Placeholders (Not currently implemented in application logic)
ENABLE_ACCOUNT_TOKENS=false
DEFAULT_USER_TOKENS=5
TOKEN_COST_PER_SNAPSHOT=1
REFUND_TOKEN_ON_INTERNAL_FAILURE=true


OUTPUT_DIR=./output
MAX_PAGE_TIMEOUT=30000
MAX_ASSET_SIZE_MB=10
MAX_TOTAL_ASSETS=150
MAX_REDIRECTS=3
MAX_CONCURRENT_JOBS=2
JOB_STALE_AFTER_MINUTES=30
ENABLE_AUTO_SCROLL=true
AUTO_SCROLL_STEP_PX=600
AUTO_SCROLL_DELAY_MS=250
AUTO_SCROLL_MAX_DURATION_MS=15000
AUTO_SCROLL_BACK_TO_TOP=true
POST_SCROLL_WAIT_MS=1000

# ─── Security & Performance Scanner Configuration ───────────────────────────
# Maximum number of scans running simultaneously
MAX_CONCURRENT_SCANS=2

# Lighthouse scanner timeout in milliseconds (default: 120000 = 2 minutes)
LIGHTHOUSE_TIMEOUT_MS=120000

# CodeQL scanner timeout in milliseconds (default: 600000 = 10 minutes)
CODEQL_TIMEOUT_MS=600000

# Minutes before a non-responding scan is marked stale (default: 30)
SCAN_STALE_AFTER_MINUTES=30

# Maximum repository size allowed for CodeQL clone in MB
MAX_REPO_SIZE_MB=200

# Days before scan output is auto-cleaned (default: 7)
SCAN_OUTPUT_MAX_AGE_DAYS=7

# Cleanup scheduler interval in milliseconds (default: 3600000 = 1 hour)
CLEANUP_INTERVAL_MS=3600000

# Scan output directory (relative to backend/)
SCAN_OUTPUT_DIR=./output

# CodeQL workspace directory (relative to backend/)
WORKSPACE_DIR=./workspaces

# Registered workspaces for CodeQL (JSON array of paths)
REGISTERED_WORKSPACES=[]

# Chrome/Chromium executable path override (auto-detected if not set)
# SCANNER_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Maximum redirects to follow during preflight SSRF check (default: 5)
SCANNER_MAX_REDIRECTS=5

# ─── CodeQL ZIP Upload Configuration ────────────────────────────────────────
# Maximum uploaded ZIP file size in MB (default: 100)
SCANNER_MAX_ZIP_SIZE_MB=100

# Maximum total extracted size in MB (default: 200)
SCANNER_MAX_EXTRACTED_SIZE_MB=200

# Maximum number of extracted files (default: 5000)
SCANNER_MAX_EXTRACTED_FILES=5000

# Maximum single file size in MB (default: 20)
SCANNER_MAX_SINGLE_FILE_MB=20

# CodeQL CLI executable path (auto-detect if not set)
# SCANNER_CODEQL_PATH=/path/to/codeql

# CodeQL query suite (default: javascript-security-extended)
SCANNER_CODEQL_QUERY_SUITE=javascript-security-extended

# Whether to cleanup workspace after scan (default: true)
SCANNER_CLEANUP_WORKSPACE_AFTER_SCAN=true

# Keep workspace even after scan for debugging (default: false)
SCANNER_KEEP_WORKSPACE=false

# Performance scan provider (pagespeed or lighthouse)
SCANNER_PERFORMANCE_PROVIDER=pagespeed

# Google PageSpeed Insights API key (optional, increases quota)
# Get one at: https://developers.google.com/speed/docs/insights/v5/get-started
# SCANNER_PAGESPEED_API_KEY=your_api_key_here
SCANNER_PAGESPEED_API_KEY=

# PageSpeed Insights strategy (mobile or desktop)
SCANNER_PAGESPEED_STRATEGY=mobile

# PageSpeed Insights locale for descriptions
SCANNER_PAGESPEED_LOCALE=id

# PageSpeed Insights API timeout in milliseconds
SCANNER_PAGESPEED_TIMEOUT_MS=120000

# Legacy local Lighthouse settings (only when SCANNER_PERFORMANCE_PROVIDER=lighthouse)
# SCANNER_LIGHTHOUSE_RUNS=3
# SCANNER_LIGHTHOUSE_RESULT_STRATEGY=median
# SCANNER_LIGHTHOUSE_FORM_FACTOR=mobile
# SCANNER_LIGHTHOUSE_THROTTLING=simulate
